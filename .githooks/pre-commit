#!/bin/sh
# Gate tests: deterministic, no database, no network, well under two seconds.
#
# Opt in once per clone, since git will not enable a versioned hooks directory
# on its own:
#
#   git config core.hooksPath .githooks
#
# Each service's checks run only when the commit touches that service, so a
# change to the app is not held up by either of them.
set -e

staged=$(git diff --cached --name-only)

if echo "$staged" | grep -q '^backend/'; then
  if [ -d backend/node_modules ]; then
    echo "pre-commit: backend typecheck"
    (cd backend && npx tsc --noEmit)

    echo "pre-commit: backend gate tests"
    (cd backend && npx tsx --test "src/**/*.test.ts")
  else
    echo "pre-commit: backend/node_modules missing, skipping backend gate tests"
  fi
fi

# The pipeline's tests need nothing but node -- no tsx, no database, no
# node_modules, and they finish in well under a tenth of a second. They cover
# the frontage rule that decides which segments the matcher is even allowed to
# see, so getting that wrong quietly deletes lines from the map.
if echo "$staged" | grep -q '^osm-pipeline/'; then
  echo "pre-commit: pipeline gate tests"
  (cd osm-pipeline && node --test "scripts/**/*.test.mjs")
fi
