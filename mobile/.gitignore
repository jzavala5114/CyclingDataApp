# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
# Gradle state from a local module build. `build/` is already covered by the
# repo root, but a module under `modules/` is a gradle project of its own and
# leaves a `.gradle/` beside its sources, full of lock files and binary caches.
.gradle/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
